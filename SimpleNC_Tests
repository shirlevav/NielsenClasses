load "SimpleNC";
load m23;

classes := Classes(G);

// 3A 3A 3A 2A
print "\nClass tuple: 3A 3A 3A 2A \n";
tuple:= [classes[3][3], classes[3][3], classes[3][3], classes[2][3]];

t := Cputime();
NielsenClass3A3A3A2A := Enumeration(G, tuple);

printf "3A3A3A2A Runtime in CPU seconds: %o \n", Cputime(t);
printf "Size of straight inner Nielsen Class = %o \n", #NielsenClass3A3A3A2A;
assert #NielsenClass3A3A3A2A eq 996;

// 3A 3A 3A 3A
print "\nClass tuple: 3A 3A 3A 3A \n";
tuple:= [classes[3][3], classes[3][3], classes[3][3], classes[3][3]];

t := Cputime();
NielsenClass3A3A3A3A := Enumeration(G, tuple);

printf "3A3A3A2A Runtime in CPU seconds: %o \n", Cputime(t);
printf "Size of straight inner Nielsen Class = %o \n", #NielsenClass3A3A3A3A;
assert #NielsenClass3A3A3A3A eq 37296;

// 6A 6A 2A 2A
print "\nClass tuple: 6A 6A 2A 2A \n";
